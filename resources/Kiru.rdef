resource app_signature "application/x-vnd.sikosis-kiru";

resource app_flags B_SINGLE_LAUNCH;

resource app_version {
	major = 0,
	middle = 1,
	minor = 9,
	variety = B_APPV_DEVELOPMENT,
	internal = 0,
	short_info = "Fast video chopping for Haiku",
	long_info = "Kiru v0.19 — mark, preview, and chop video without re-encoding"
};

resource file_types message {
	"types" = "video/*"
};


resource(102, "KIRU:ABOUT_ICON") #'KICO' import "Kiru-about.rgba";

resource(101, "BEOS:L:STD_ICON") #'ICON' import "Kiru-32.icon";

resource(101, "BEOS:M:STD_ICON") #'MICN' import "Kiru-16.icon";
